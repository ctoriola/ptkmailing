# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=
# Sender address on your verified Resend domain
MAIL_FROM="Primetek SSC <mailing@primetekssc.ng>"
# Random string, e.g. `openssl rand -base64 32`
AUTH_SECRET=
# Only emails at this domain can sign in
ALLOWED_EMAIL_DOMAIN=primetekssc.ng
# Added automatically when you connect a Vercel Blob store to the project.
# Newer stores use BLOB_STORE_ID (+ Vercel's OIDC token); older ones use BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=
# BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public", matching the Blob store's access setting
NEXT_PUBLIC_BLOB_ACCESS=private
# Admin page (/admin). Set the password in Vercel only, never commit it.
ADMIN_EMAIL=admin@primetekssc.ng
ADMIN_PASSWORD=
# Public URL of the app, used for the logo in emails (defaults to the request's domain)
APP_URL=https://mailing.primetekssc.ng
